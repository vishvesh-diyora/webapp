# Copy this file to `.env` in the project root and fill in your values.
# `.env` is gitignored — never commit real secrets.

# ── Supabase (Dashboard → Project Settings → API) ───────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key

# Optional: production web OAuth callback (leave empty for localhost auto-detect)
WEB_REDIRECT_URL=

# Mobile deep link for auth callbacks
MOBILE_REDIRECT_URL=io.supabase.webapp://login-callback

# ── Cloudflare Pages (single account for all users) ─────────────────────────
# Account ID: Cloudflare Dashboard → sidebar → Account ID
# API Token: My Profile → API Tokens (Account Read + Cloudflare Pages Edit)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
